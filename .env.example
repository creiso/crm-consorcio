NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Somente no servidor (Vercel > Settings > Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# Segredo compartilhado com o Apps Script (sincronização em tempo real das planilhas)
SYNC_SECRET=troque-por-um-segredo-longo
# Segredo do cron diário da Vercel
CRON_SECRET=troque-por-um-segredo-longo
